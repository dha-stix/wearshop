rules_version = '2';

// Product photos: public to read, only managers upload, images only, max 8 MB each.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'manager'
        && (request.resource == null
            || (request.resource.contentType.matches('image/.*') && request.resource.size < 8 * 1024 * 1024));
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }
  }
}
