rules_version = '2';

// WearShop Firestore rules. Roles live on users/{uid}.role: "customer", "staff" or "manager".
// - Anyone can read live products; staff and managers also see drafts; only managers write products.
// - Orders are created and marked paid only by the server (Admin SDK bypasses these rules).
// - Staff and managers move orders through delivery statuses and notify customers.
// - Roles are only changed by the server (/api/team), which checks the caller is a manager.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isManager() {
      return role() == 'manager';
    }
    // Staff or manager: anyone who works on orders.
    function isStoreTeam() {
      return role() in ['manager', 'staff'];
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      // A new profile is always a customer; roles are changed by the server only.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer';
      allow update: if signedIn() && request.auth.uid == uid
        && onlyChanges(['name', 'email', 'photoURL', 'lastLoginAt', 'shipping', 'updatedAt']);
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'live' || isStoreTeam();
      allow create, update: if isManager()
        && request.resource.data.name is string
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0;
      allow delete: if isManager();
    }

    match /carts/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStoreTeam());
      allow update: if isStoreTeam()
        && onlyChanges(['status', 'timeline', 'updatedAt'])
        && request.resource.data.status in ['paid', 'packed', 'shipped', 'out_for_delivery', 'delivered', 'cancelled'];
      allow create, delete: if false;
    }

    match /notifications/{noteId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isManager());
      // Order updates from staff or managers notify the customer.
      allow create: if isStoreTeam()
        && request.resource.data.keys().hasOnly(['userId', 'orderId', 'orderNumber', 'title', 'body', 'read', 'createdAt'])
        && request.resource.data.read == false;
      // Customers can only mark their own notifications as read.
      allow update: if signedIn() && resource.data.userId == request.auth.uid && onlyChanges(['read']);
    }

    // Server-only collections.
    match /counters/{doc} {
      allow read, write: if false;
    }
    match /webhookEvents/{doc} {
      allow read, write: if false;
    }
  }
}
